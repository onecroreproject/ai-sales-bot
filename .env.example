# Database connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@127.0.0.1:5432/ai_sales_bot

# VPS SSH Tunnel Configuration (Set USE_SSH_TUNNEL=True to connect from local PC to remote VPS database)
USE_SSH_TUNNEL=False
VPS_HOST=147.93.31.98
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=your_vps_root_password_here

# OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=30.0

# JWT Security Configuration
JWT_SECRET_KEY=change_this_to_a_secure_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
